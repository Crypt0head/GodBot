{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "GodBot",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceRoot}/src/main.cpp",
                "${workspaceRoot}/src/GodBot.cpp",
                "${workspaceRoot}/src/binance_api.cpp",
                "${workspaceRoot}/src/base_api.cpp",
                "${workspaceRoot}/src/Kline.cpp",
                "${workspaceRoot}/src/GB_LogData.cpp",
                "${workspaceRoot}/src/GB_Logger.cpp",
                "${workspaceRoot}/src/GB_SimpleStrategy.cpp",
                "${workspaceRoot}/src/GB_RSIStrategy.cpp",
                "-o",
                "${workspaceRoot}/bin/App.out",
                "-lssl",
                "-lcrypto",
                "-lpthread",
                "-lboost_program_options",
                "-std=c++20"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "GodBot release",
            "command": "/usr/bin/g++",
            "args": [
                "-O2",
                "${workspaceRoot}/src/main.cpp",
                "-o",
                "${workspaceRoot}/bin/App.out",
                "-lcurl",
                "-lssl",
                "-lcrypto",
                "-lpthread",
                "-lboost_program_options",
                "-std=c++20"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "UNIT-TESTS",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",             
                "${workspaceRoot}/src/binance_api.cpp",
                "${workspaceRoot}/src/base_api.cpp",
                "${workspaceRoot}/src/Kline.cpp",
                "${workspaceRoot}/tests/general_tests.cpp",
                "-o",
                "${workspaceRoot}/bin/Test.out",
                "-lssl",
                "-lcrypto", 
                "-lpthread",
                "-std=c++20"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Unit-Tests"
        },
        {
            "type": "cppbuild",
            "label": "UNIT-TESTS-TA",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",             
                "${workspaceRoot}/src/Kline.cpp",
                "${workspaceRoot}/tests/ta_tests.cpp",
                "-o",
                "${workspaceRoot}/bin/TA-Test.out",
                "-lssl",
                "-lcrypto", 
                "-lpthread",
                "-std=c++20"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Unit-Tests-TA"
        }
    ],
    "version": "2.0.0"
}